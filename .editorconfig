# EditorConfig helps keep files consistent across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.swift]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing whitespace is meaningful in Markdown hard line breaks.
trim_trailing_whitespace = false

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab
